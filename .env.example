# Lingon real backend — copy to .env and fill in. NEVER commit .env.
PORT=8000

# Google AI Studio (Gemini) — server-side only. Frontend never sees this.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (free tier) — https://supabase.com/dashboard
# Create a project, then paste Project URL + anon key here.
# Optional: SUPABASE_SERVICE_ROLE_KEY for server-side writes (keep secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to encrypt vault secrets at rest on the server fallback store.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
