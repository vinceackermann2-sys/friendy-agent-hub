# Lingon real backend — copy to .env and fill in. NEVER commit .env.
PORT=8000

# Microsoft Foundry — agent, transcription, and image deployments.
# Server-side only. Frontend never sees this key.
# Every *_MODEL value is an Azure deployment name (often the model name by default).
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=gpt-6-luna
AZURE_FOUNDRY_FALLBACK_MODEL=gpt-6-luna
AZURE_FOUNDRY_REASONING_EFFORT=xhigh
AZURE_FOUNDRY_TRANSCRIPTION_MODEL=gpt-4o-transcribe
AZURE_FOUNDRY_IMAGE_MODEL=gpt-image-2
# Optional override. By default this is derived from the project endpoint as
# https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_OPENAI_ENDPOINT=
# GPT-6 Luna prices in USD per million tokens; override if Azure pricing differs.
MODEL_RATE_IN_USD_PER_MILLION=0.10
MODEL_RATE_CACHED_IN_USD_PER_MILLION=0.01
MODEL_RATE_CACHE_WRITE_USD_PER_MILLION=0.125
MODEL_RATE_OUT_USD_PER_MILLION=0.50

# Per-user Azure VM sandbox for Belna/Lingon. When these are set, each user gets one VM
# (lingon-sb-<hash>) for untrusted code/files/browser. Until they are set,
# the harness uses an isolated per-user local workspace and keeps code_run
# DISABLED (node:vm is not a security boundary).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=swedencentral
AZURE_VM_SIZE=Standard_B2als_v2
AZURE_STORAGE_ACCOUNT=
AZURE_ADMIN_USERNAME=lingon
# Shell and code run in this hardened image inside the per-user VM. The VM
# bootstrap builds it locally when the tag is not already present; production
# can point this at a pre-built, pinned image in a private registry.
AZURE_WORKER_IMAGE=localhost/lingon-worker:20260921
# Full OS stays warm only after a VM tool, never merely because the app is open.
AZURE_VM_IDLE_MINUTES=5
AZURE_DURABLE_STATE=true
AZURE_PER_USER_VM=true
# First use creates that user's VM (Azure billing starts only while it is running).
AZURE_AUTO_PROVISION=true

# Optional external presence runtime. Leave disabled for the normal deployment:
# the per-user VM owns the worker container and is the only compute service.
# Enabling this requires an explicit billing opt-in as well as an Azure
# Container Apps dynamic-session pool.
AZURE_CONTAINER_SESSION_ENDPOINT=
AZURE_CONTAINER_SESSION_TOUCH_PATH=/health
# Only "external" plus the explicit opt-in below can allocate a session.
AZURE_CONTAINER_SESSION_PRESENCE=off
AZURE_CONTAINER_SESSION_ALLOW_BILLING=false
CONTAINER_SESSION_COOLDOWN_SECONDS=600
# Stable private HMAC key for opaque per-user session identifiers. If omitted,
# ENCRYPTION_KEY (then AZURE_CLIENT_SECRET) is used server-side.
WORKSPACE_SESSION_SECRET=

# Supabase (free tier) — https://supabase.com/dashboard
# New dashboard shows PUBLISHABLE + SECRET keys; old shows ANON + SERVICE_ROLE.
# Either pair works — backend accepts both names. SECRET stays server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Used to encrypt vault secrets at rest on the server fallback store.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Google sign-in via our own OAuth bridge (no third-party hosted auth pages).
# 1. https://console.cloud.google.com/apis/credentials → Create OAuth client ID (Web application)
# 2. Authorized redirect URI: https://belna.se/api/auth/google/callback
#    (add http://localhost:8000/api/auth/google/callback for local dev)
# 3. Paste the client ID + secret below. Public origin for SITE_URL in prod.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_URL=https://belna.se
# The browser relay uses this origin to make one outbound wss:// connection
# from each private VM. Keep it on the same public HTTPS origin as the app.
LINGON_PUBLIC_ORIGIN=https://belna.se

# Production: set BEHIND_PROXY=1 when a reverse proxy (Caddy/Nginx) terminates TLS.
BEHIND_PROXY=

# Node server polls due schedule triggers every 30 seconds. Set to off when a
# separate worker owns automation execution.
AUTOMATION_WORKER=on

# Stripe — real payments (monthly Pro/Max subscriptions + gift flow).
# 1. Paste your secret key (test: sk_test_..., live: sk_live_...)
# 2. node scripts/setup-stripe.mjs  → creates the real Pro/Max products
# 3. Paste the printed PRICE IDs below + webhook signing secret (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_PRO_PROMO_PRICE_ID=
STRIPE_MAX_PROMO_PRICE_ID=
STRIPE_CREDITS_50_PRICE_ID=
STRIPE_CREDITS_100_PRICE_ID=
STRIPE_CREDITS_200_PRICE_ID=
STRIPE_CREDITS_300_PRICE_ID=
STRIPE_CREDITS_500_PRICE_ID=
STRIPE_CREDITS_750_PRICE_ID=
STRIPE_CREDITS_1000_PRICE_ID=
STRIPE_GIFT_50_PRICE_ID=
STRIPE_GIFT_100_PRICE_ID=

# Composio — connected apps (server-side only, never exposed to the browser).
# Project API key from https://composio.dev → Settings → Project Settings → API Keys.
# Enables Belna Apps: users connect Gmail, GitHub, Slack, Calendar, etc. via
# hosted Connect Links, and the agent runs real tools as the signed-in user.
# Webhook for app triggers: POST https://belna.se/api/composio/webhook
COMPOSIO_API_KEY=
# Signing secret returned by the Composio webhook subscription. Production can
# also load this from Supabase Vault through get_server_secret.
COMPOSIO_WEBHOOK_SECRET=

# Shared only between the Supabase VM sweeper Edge Function and this backend.
# Production stores it in Supabase Vault; do not expose it to the browser.
VM_SWEEP_TOKEN=

# Privy — agent wallet + attached card (server-side only, never in the browser).
# Dashboard: https://dashboard.privy.io → App settings → Basics
# Keys stay in Privy TEEs. Card issuing is licensed via Privy → Bridge + Stripe Issuing.
# 1. Create an app, paste App ID + App secret below.
# 2. Production cards: contact sales@privy.io, then add BRIDGE_API_KEY.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_CHAIN=base
PRIVY_WALLET_CAIP2=eip155:8453
PRIVY_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BRIDGE_API_KEY=

# Shop Pay / UCP — Dev Dashboard → Catalogs → Get an API key.
# Redirect URI: {SITE_URL}/api/shop-pay/callback
# Tokens stay on the server. The agent never sees card numbers.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Resend — each agent gets name@mail.belna.se (catch-all inbound).
# 1. https://resend.com/domains → add mail.belna.se (NOT apex belna.se)
# 2. Add SPF / DKIM / DMARC as shown
# 3. Enable Receiving and publish the MX record on mail.belna.se
# 4. Webhook: POST https://belna.se/api/mail/webhook  event email.received
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_DOMAIN=mail.belna.se

# Optional: short-lived API hosts only read task snapshots; a separate Node
# worker runs tasks with this flag unset. Configure CHAT_TASK_WORKER_URL in the
# existing Supabase vault for the scheduled recovery pump. See agents/README.md.
CHAT_TASK_WORKER_ONLY=false
